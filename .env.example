# База данных — PostgreSQL в Supabase (проект AsilDent).
# Supabase → Project Settings → Database → Connection string → Transaction pooler (порт 6543):
#   postgresql://postgres.<ref>:<пароль>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# Публичный адрес сайта без слэша в конце (нужен для SEO, sitemap, ссылок в Telegram).
SITE_URL="http://localhost:3000"

# Вход в админку /admin. Пароль — любой надёжный. SESSION_SECRET — случайная строка от 32 символов:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="replace-with-random-64-hex-chars-replace-with-random-64-hex"

# Уведомления о новых записях в Telegram (необязательно). Пусто — уведомления выключены.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Vercel Blob для загрузки фото врачей и логотипа на Vercel (необязательно локально).
BLOB_READ_WRITE_TOKEN=""

# Секрет для Vercel Cron (/api/cron/reviews — отзывы из 2GIS). Vercel передаёт его сам.
CRON_SECRET=""
